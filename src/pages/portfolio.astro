---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="Mesa de Trabajo">
  <main class="table-container">
    <div class="table-surface">
      <button
        id="phone-trigger"
        class="interactive-object phone"
        data-modal="contacto"
      >
        <div class="placeholder red"></div>
      </button>
      <button class="interactive-object scroll" data-modal="curriculum">
        <div class="placeholder gold"></div>
      </button>
      <button class="interactive-object box" data-modal="proyectos">
        <div class="placeholder blue"></div>
      </button>
    </div>

    <dialog id="main-modal" class="paper-modal">
      <div class="modal-body">
        <h2 id="modal-title">Titulo</h2>
        <div id="modal-content">Contenido</div>
        <button id="close-modal" class="close-btn">X</button>
      </div>
    </dialog>

    <template id="template-contacto">
      <form
        class="contact-form"
        action="https://formspree.io/f/mqegnjyn"
        method="POST"
      >
        <label for="name">Nombre</label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="Nombre"
          required
        />

        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Email"
          required
        />

        <label for="message">Mensaje</label>
        <textarea
          name="message"
          id="message"
          rows="4"
          placeholder="¿Qué tenés en mente?"></textarea>
        <button type="submit" class="btn-primary">Enviar</button>
      </form>
      <nav class="social-icons" aria-label="Redes">
        <a
          href="https://www.linkedin.com/in/r-gargano"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
            ></path></svg
          ></a
        >
        <a
          href="https://github.com/RominaGG"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.042-1.416-4.042-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path></svg
          ></a
        >
      </nav>
    </template>
  </main>
</Layout>

<script>
  interface ContentData {
    title: string;
    text: string;
  }

  const contentMap: Record<string, ContentData> = {
    contacto: {
      title: "Hola",
      text: "Podes dejarme un mensaje o contactarme por mis redes.",
    },
    curriculum: {
      title: " CV",
      text: "Estudiante de Desarrollo de Software y Ciencia de Datos",
    },
  };

  const modal = document.getElementById("main-modal") as HTMLDialogElement;
  const titleElem = document.getElementById("modal-title");
  const contentElem = document.getElementById("modal-content");
  const buttons = document.querySelectorAll(".interactive-object[data-modal]");
  const closeBtn = document.getElementById("close-modal");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const type = btn.getAttribute("data-modal");
      if (type && contentMap[type] && modal && titleElem && contentElem) {
        titleElem.innerText = contentMap[type].title;
        contentElem.innerHTML = `<p>${contentMap[type].text}</p>`;

        const template = document.getElementById(
          `template-${type}`,
        ) as HTMLTemplateElement;
        if (template) {
          const clone = template.content.cloneNode(true);
          contentElem?.appendChild(clone);
        }

        if (type === "contacto") {
          const form = contentElem.querySelector(
            ".contact-form",
          ) as HTMLFormElement;

          form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const submitBtn = form.querySelector("button") as HTMLButtonElement;
            submitBtn.disabled = true;
            submitBtn.innerText = "Enviando...";
            try {
              const response = await fetch(form.action, {
                method: form.method,
                body: new FormData(form),
                headers: { Accept: "application/json" },
              });

              if (response.ok) {
                contentElem.innerHTML = ` <div class="success-container">
                    <p class= 'success-msg'>Mensaje enviado!</p>
                    <p>Pronto recibirás una respuesta</p> 
                    </div>`;
                    if (titleElem) titleElem.style.display = 'none';
              } else {
                throw new Error();
              }
            } catch (error) {
              submitBtn.disabled = false;
              submitBtn.innerText = "Reintentar";
              alert("No se pudo enviar el mensaje. Intentalo de nuevo");
            }
          });
        }
        modal.showModal();
      }
    });
  });

  closeBtn?.addEventListener("click", () => modal.close());

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });
</script>

<style>

  .table-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: aliceblue;
  }

  .table-surface {
    position: relative;
    width: 90%;
    max-width: 1000px;
    aspect-ratio: 16 / 9;
    background-image: url("/assets/img/camino_mock.jpg");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border: 2px solid #333;
  }

  .interactive-object {
    position: absolute;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .interactive-object:hover {
    transform: scale(1.1);
  }

  .phone {
    top: 50%;
    left: 15%;
    width: 80px;
    height: 80px;
  }
  .scroll {
    top: 50%;
    left: 50%;
    width: 80px;
    height: 80px;
  }
  .box {
    top: 50%;
    left: 75%;
    width: 80px;
    height: 80px;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    opacity: 0.8;
    transition: 0.3s;
    
  }
  .placeholder:hover {
    opacity: 1;
    transform: scale(1.1) rotate(5deg);
  }

  .red {
    background: red;
  }
  .gold {
    background: #ffd700;
  }
  .blue {
    background: #00a8ff;
  }

  .paper-modal {
    border: 3px solid #222;
    border-radius: 255px 15px 225px 15px / 5px 225px 15px 255px;
    background: #fffcf2;
    transform: rotate(-1deg);
    box-shadow: 10px 10px 0px rgba(0, 0, 0, 0.2);
    padding: 3rem;
    max-width: 550px;
    width: 80%;
    font-family: var(--font-main);
  }

  .paper-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  #modal-title {
    font-family: var(--font-fancy);
    font-size: 3rem;
  }

  .contact-form label {
    font-size: 1.6rem;
    margin-bottom: -5px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
  }

  .contact-form input,
  .contact-form textarea {
    border: none;
    border-bottom: 2px dashed #555;
    border-radius: 0 0 10px 30px / 0 0 5px 15px;
    background: transparent;
    font-family: var(--font-main);
    font-size: 1.5rem;
    padding: 10px 5px;
    outline: none;
    color: #333;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-bottom: 2px solid #d32f2f; /* Rojo al escribir */
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    font-family: var(--font-main);
    opacity: 0.6;
  }
  .btn-primary {
    background: #d32f2f;
    color: aliceblue;
    border-radius: 50% 20%/ 10% 40%;
    padding: 10px 20px;
    cursor: pointer;
    font-family: var(--font-fancy);
    font-weight: bold;
  }

  .btn-primary:hover {
    transform: scale(1.05) rotate(2deg);
    filter: brightness(1.2);
  }

  .success-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 0;
    animation: zoomIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .success-msg {
    font-size: 2.5rem;
    color: #189520;
    margin-bottom: 0.5rem;
  }
  .social-icons {
    display: flex;
    justify-content: space-around;
    border-top: 1px dashed #ccc;
    padding-top: 15px;
  }

  .social-icons a {
    color: #d32f2f;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .close-btn {
    position: absolute;
    top: 10px;
    right: 15px;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    font-family: var(--font-fancy);
    color: #555;
    transition: transform 0.2s;
  }

  .close-btn:hover {
    transform: scale(1.2) rotate(90deg);
    color: #d32f2f;
  }

  @media (max-width: 768px) {
    .table-surface {
      background-image: url("/assets/img/mesa_redonda.jpg");
      width: 350px;
      height: 350px;
    }

    .phone {
      top: 10%;
      left: 50%;
    }
    .scroll {
      top: 50%;
      left: 10%;
    }
    .box {
      top: 60%;
      left: 75%;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes zoomIn {
    from {opacity: 0; transform: scale(0.5);}
    to { opacity: 1; transform: scale(1);}
  }
</style>
