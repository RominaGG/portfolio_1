---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import ProjectBook from "../components/ProjectBook.astro";
---

<Layout title="Mesa de Trabajo">
  <main class="table-container">
    <div class="language-switch">
      <button id="btn-es" class="lang-btn active">ES</button>
      <span>/</span>
      <button id="btn-en" class="lang-btn">EN</button>
    </div>
    <div class="table-surface">
      <button
        id="phone-trigger"
        class="interactive-object phone"
        data-modal="contacto"
      >
        <div class="placeholder red"></div>
      </button>
      <button class="interactive-object scroll" data-modal="curriculum">
        <div class="placeholder gold"></div>
      </button>
      <button class="interactive-object box" data-modal="proyectos">
        <div class="placeholder blue"></div>
      </button>
    </div>

    <dialog id="main-modal" class="paper-modal">
      <div class="modal-body">
        <h2 id="modal-title">Titulo</h2>
        <div id="modal-content">Contenido</div>
        <button id="close-modal" class="close-btn">X</button>
      </div>
    </dialog>
    <dialog id="book-modal" class="book-modal-container">
      <div id="book-content"></div>
      <button id="close-book" class="close-btn">X</button>
    </dialog>

    <template id="template-contacto">
      <form
        class="contact-form"
        action="https://formspree.io/f/mqegnjyn"
        method="POST"
      >
        <label for="name" id="label-name"></label>
        <input type="text" id="name" name="name" required />

        <label for="email" id="label-email"></label>
        <input type="email" id="email" name="email" required />

        <label for="message" id="label-message"></label>
        <textarea name="message" id="message" rows="4"></textarea>
        <button type="submit" class="btn-primary" id="btn-submit-form"></button>
      </form>
      <nav class="social-icons" aria-label="Redes">
        <a
          href="https://www.linkedin.com/in/r-gargano"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
            ></path></svg
          ></a
        >
        <a
          href="https://github.com/RominaGG"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.042-1.416-4.042-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path></svg
          ></a
        >
      </nav>
    </template>

    <template id="template-proyectos-es">
      <ProjectBook lang="es"/>
    </template>
    <template id="template-proyectos-en">
      <ProjectBook lang="en" />
    </template>
  </main>
</Layout>

<script>
  import { translations } from "../data/content";
  //define la estructura del lenguaje para evitar errores en TS
  type Language = "es" | "en";

  // Le decimos que translations tiene es y en, y adentro tiene contacto y curriculum
  type TranslationsKeys = keyof (typeof translations)["es"];

  let currentLang: Language = "es";
  const modal = document.getElementById("main-modal") as HTMLDialogElement;
  const titleElem = document.getElementById("modal-title");
  const contentElem = document.getElementById("modal-content");
  const buttons = document.querySelectorAll(".interactive-object[data-modal]");
  const closeBtn = document.getElementById("close-modal");
  const bookModal = document.getElementById("book-modal") as HTMLDialogElement;
  const bookContent = document.getElementById("book-content");
  const closeBookBtn = document.getElementById("close-book");

  // Selector de idiomma
  const btnEs = document.getElementById("btn-es");
  const btnEn = document.getElementById("btn-en");

  const updateLangUI = (lang: Language) => {
    currentLang = lang;
    btnEs?.classList.toggle("active", lang === "es");
    btnEn?.classList.toggle("active", lang === "en");
  };
  btnEs?.addEventListener("click", () => updateLangUI("es"));
  btnEn?.addEventListener("click", () => updateLangUI("en"));

  // botones de la mesa
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const type = btn.getAttribute("data-modal") as TranslationsKeys;

      if (
        type &&
        translations[currentLang][type] &&
        modal &&
        titleElem &&
        contentElem
      ) {
        const data = (translations[currentLang] as any)[type];

        if (type === "proyectos") {
          if (bookContent) {
            bookContent.innerHTML = "";
            const template = document.getElementById(
              `template-proyectos-${currentLang}`,
            ) as HTMLTemplateElement;
            if (template) {
              bookContent.appendChild(template.content.cloneNode(true));
              bookModal?.showModal();
              initBook();
            } else {
              console.error(
                `falta el te,plate: template-proyectos-${currentLang} en el HTML`,
              );
            }
          }
        } else {
          if (titleElem) {
            //setear titulo y visibilidad
            titleElem.innerText = data.title || "Sin título";
            titleElem.style.display = "block";
          }
          // html base del modal
          let htmlContent = `
      <div class= "modal-inner-content">
        <p class= "intro-text">${data.intro || ""}</p>
        ${data.body ? `<p class="body-text">${data.body}</p>` : ""} 
        </div>`;

          // CV
          if (type === "curriculum") {
            htmlContent += `
          <div class="skills-section">
            <h3>${data.skillsTitle || "Skills"}</h3>
            <ul class= "skills-list">
              ${data.skills.map((s: string) => `<li>${s}</li>`).join("")}
              </ul>
              </div>
              <a href="/cv-romina-${currentLang}.pdf" download class= "btn-download">
                ${data.downloadBtn || "Download CV"}
                </a>`;
          }
          if (contentElem) {
            contentElem.innerHTML = htmlContent;
          }
          if (type === "contacto") {
            const template = document.getElementById(
              "template-contacto",
            ) as HTMLTemplateElement;
            if (template && contentElem) {
              const clone = template.content.cloneNode(
                true,
              ) as DocumentFragment;

              //Traduccion dinamica del form
              const data = translations[currentLang].contacto;

              (clone.querySelector("#label-name") as HTMLElement).innerText =
                data.formName;
              (clone.querySelector("#name") as HTMLInputElement).placeholder =
                data.formName;
              (clone.querySelector("#label-email") as HTMLElement).innerText =
                data.formEmail;
              (clone.querySelector("#email") as HTMLInputElement).placeholder =
                data.formEmail;
              (clone.querySelector("#label-message") as HTMLElement).innerText =
                data.formMessage;
              (
                clone.querySelector("#message") as HTMLTextAreaElement
              ).placeholder = data.formPlaceholder;
              (
                clone.querySelector("#btn-submit-form") as HTMLElement
              ).innerText = data.formBtn;

              contentElem.appendChild(clone);
              setupContactForm();
            }
          }modal?.showModal();
        }
        
      }
    });
  });

  function setupContactForm() {
    const form = document.querySelector(".contact-form") as HTMLFormElement;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector("button") as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.innerText = currentLang === "es" ? "Enviando..." : "Sending...";

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (response.ok) {
          contentElem!.innerHTML = `
        <div class='success-container'>
          <p class='success-msg'>${currentLang === "es" ? "Mensaje enviado!" : "Message sent!"}</p>
          <p> ${currentLang === "es" ? "Pronto recibirás una respuesta." : "You will receive a reply soon."}</p>
          </div>`;
          if (titleElem) titleElem.style.display = "none";
        } else {
          throw new Error();
        }
      } catch (error) {
        submitBtn.disabled = false;
        submitBtn.innerText = currentLang === "es" ? "Reintentar" : "Retry";
        alert(currentLang === "es" ? "Error al enviar." : "Error sending");
      }
    });
  }

  function initBook() {
    const leaves = document.querySelectorAll(".leaf");
    const btnPrev = document.getElementById("btn-prev") as HTMLButtonElement;
    const btnNext = document.getElementById("btn-next") as HTMLButtonElement;
    let currenPage = 0;

    const updateButtons = () => {
      if (btnPrev && btnNext) {
        btnPrev.disabled = currenPage === 0;
        btnNext.disabled = currenPage === leaves.length;
      }
    };

    if (btnNext) {
      btnNext.onclick = () => {
        if (currenPage < leaves.length) {
          leaves[currenPage].classList.add("flipped");
          currenPage++;
          updateButtons();
        }
      };
    }
    if (btnPrev) {
      btnPrev.onclick = () => {
        if (currenPage > 0) {
          currenPage--;
          leaves[currenPage].classList.remove("flipped");
          updateButtons();
        }
      };
    }
    updateButtons();
  }
  closeBtn?.addEventListener("click", () => modal?.close());
  closeBookBtn?.addEventListener("click", () => bookModal?.close());
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });
</script>

<style>
  .table-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: aliceblue;
  }

  .table-surface {
    position: relative;
    width: 90%;
    max-width: 1000px;
    aspect-ratio: 16 / 9;
    background-image: url("/assets/img/camino_mock.jpg");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border: 2px solid #333;
  }

  .interactive-object {
    position: absolute;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .interactive-object:hover {
    transform: scale(1.1);
  }

  .phone {
    top: 50%;
    left: 15%;
    width: 80px;
    height: 80px;
  }
  .scroll {
    top: 50%;
    left: 50%;
    width: 80px;
    height: 80px;
  }
  .box {
    top: 50%;
    left: 75%;
    width: 80px;
    height: 80px;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    opacity: 0.8;
    transition: 0.3s;
  }
  .placeholder:hover {
    opacity: 1;
    transform: scale(1.1) rotate(5deg);
  }

  .red {
    background: red;
  }
  .gold {
    background: #ffd700;
  }
  .blue {
    background: #00a8ff;
  }

  .paper-modal {
    border: 3px solid #222;
    border-radius: 255px 15px 225px 15px / 5px 225px 15px 255px;
    background: #fffcf2;
    transform: rotate(-1deg);
    box-shadow: 10px 10px 0px rgba(0, 0, 0, 0.2);
    padding: 3rem;
    max-width: 550px;
    width: 80%;
    font-family: var(--font-main);
  }

  .paper-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  #modal-title {
    font-family: var(--font-fancy);
    font-size: 3rem;
  }

  .book-modal-container {
    border: none;
    background: transparent;
    max-width: 1200px;
    width: 95vw;
    height: 90vh;
    padding: 0;
    overflow: visible;
  }

  .book-modal-container[open] {
    display: flex;
    justify-content: center;
    align-items: center;

  }
  #book-content {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .book-modal-container::backdrop {
    background: rgba(0, 0, 0, 0.05);
  }

  .contact-form label {
    font-size: 1.6rem;
    margin-bottom: -5px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
  }

  .contact-form input,
  .contact-form textarea {
    border: none;
    border-bottom: 2px dashed #555;
    border-radius: 0 0 10px 30px / 0 0 5px 15px;
    background: transparent;
    font-family: var(--font-main);
    font-size: 1.5rem;
    padding: 10px 5px;
    outline: none;
    color: #333;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-bottom: 2px solid #d32f2f; /* Rojo al escribir */
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    font-family: var(--font-main);
    opacity: 0.6;
  }
  .btn-primary {
    background: #d32f2f;
    color: aliceblue;
    border-radius: 50% 20%/ 10% 40%;
    padding: 10px 20px;
    cursor: pointer;
    font-family: var(--font-fancy);
    font-weight: bold;
  }

  .btn-primary:hover {
    transform: scale(1.05) rotate(2deg);
    filter: brightness(1.2);
  }

  .success-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 0;
    animation: zoomIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .success-msg {
    font-size: 2.5rem;
    color: #189520;
    margin-bottom: 0.5rem;
  }
  .social-icons {
    display: flex;
    justify-content: space-around;
    border-top: 1px dashed #ccc;
    padding-top: 15px;
  }

  .social-icons a {
    color: #d32f2f;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .language-switch {
    position: absolute;
    top: 25px;
    right: 25px;
    font-family: var(--font-main);
    background: rgba(255, 255, 255, 0.8);
    padding: 5px 15px;
    border-radius: 20px;
    border: 1px solid #333;
    z-index: 10;
  }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-weight: bold;
    color: #888;
    transition: 0.3s;
  }
  .lang-btn.active {
    color: #d32f2f;
    text-decoration: underline;
  }
  .modal-inner-content {
    margin-bottom: 1.5rem;
  }

  .intro-text,
  .body-text {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  .skills-section h3 {
    font-family: var(--font-fancy);
    font-size: 2rem;
    margin-top: 1.5rem;
    border-bottom: 1px dashed #ccc;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  .skills-list li {
    background: rgba(211, 47, 47, 0.1);
    border: 1px solid #d32f2f;
    padding: 5px 12px;
    border-radius: 12px 4px 15px 5px;
    font-size: 1rem;
    font-weight: bold;
  }

  .btn-download {
    display: block;
    text-align: center;
    text-decoration: none;
    color: #333;
    border: 2px solid #333;
    padding: 10px;
    margin-top: 1rem;
    transform: 0.3s;
  }

  .btn-download:hover {
    background: #333;
    color: #fffcf2;
  }

  .close-btn {
    position: absolute;
    top: 10px;
    right: 15px;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    font-family: var(--font-fancy);
    color: #555;
    transition: transform 0.2s;
  }

  .close-btn:hover {
    transform: scale(1.2) rotate(90deg);
    color: #d32f2f;
  }

  @media (max-width: 768px) {
    .table-surface {
      background-image: url("/assets/img/mesa_redonda.jpg");
      width: 350px;
      height: 350px;
    }

    .phone {
      top: 10%;
      left: 50%;
    }
    .scroll {
      top: 50%;
      left: 10%;
    }
    .box {
      top: 60%;
      left: 75%;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes zoomIn {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
