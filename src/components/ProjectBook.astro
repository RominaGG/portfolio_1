<style>
  
  * {
    box-sizing: border-box;
  }
  .book-scene {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 900px;
    gap: 20px;
    perspective: 1500px; /* Profundidad del 3D*/
    margin: 0 auto;
  }
  .book {
    display: flex;
    width: 100%;
    max-width: 800px;
    height: 550px;
    background: transparent;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    border-radius: 5px;
    position: relative;
  }

  .book::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 40px;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.3) 100%);
    transform: translateX(-50%);
    z-index: 200;
    pointer-events: none;
  }
  
  .page {
    position: absolute;
    width: 50%;
    height: 100%;
    top: 0;
  }

  .page-left {
    left: 0;
    background: #fffcf2;
    border-radius: 15px 0 0 15px;
    padding: 3rem 4rem 3rem 3rem;
    box-shadow: inset -15px 0 20px -15px rgba(0, 0, 0, 0.05);
    z-index: 1;
  }

  .page-left h2 {
    font-family: var(--font-fancy);
    font-size: 3.5rem;
    color: #d32f2f;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }
  .page-left {
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .page-right {
    left: 50%;
    transform-origin: left center; /*Gira desde el borde izq */
    transition: transform 0.8s cubic-bezier(0.645, 0.045, 0.355, 1);
    transform-style: preserve-3d; /*Permite caras frontales y traseras */
  } 
  .page-right.flipped {
    transform: rotateY(-180deg) /*Da vuelta la pagina */;
  }

  .page-face {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    background: #fffcf2;
    padding: 3rem 3rem 3rem 4rem;
  }

  .page-front {
    border-radius: 0 15px 15px 0;
    box-shadow: inset 15px 0 20px -15px rgba(0, 0, 0, 0.02);
  }

  .page-back {
    transform: rotateY(180deg); /*Pre-rotacion para que este lista */
    background: #f4eedc;
    border-radius: 15px 0 0 15px;
    box-shadow: inset -15px 0 20px -15px rgba(0, 0, 0, 0.02);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 5rem;
    opacity: 0.3;
  }

  .project-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 255px 15px 225px 15px / 5px 225px 15px 255px;
    border: 3px solid #333;
    margin-bottom: 15px;
  }

  /* Tarjeta de proyecto*/

  .project-card h4 {
    font-family: var(--font-fancy);
    font-size: 2.2rem;
    margin: 0 0 10px 0;
    color: #333;
  }

  .project-card p {
    font-size: 1.1rem;
    line-height: 1.4;
    margin-bottom: 15px;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 15px 0;
  }

  .project-tags span {
    background: rgba(211, 47, 47, 0.1);
    color: #d32f2f;
    padding: 4px 12px;
    border-radius: 255px 15px 225px 15px / 5px 225px 15px 255px;
    font-size: 0.85rem;
    font-weight: bold;
    border: 1px dashed rgba(211, 47, 47, 0.3);
  }

  .project-link {
    display: inline-block;
    background: #333;
    color: #fffcf2;
    padding: 10px 20px;
    border-radius: 255px 15px 225px 15px / 5px 225px 15px 255px;
    text-decoration: none;
    transition: 0.3s;
    margin-top: 5px;
    font-family: var(--font-fancy);
    letter-spacing: 1px;
  }

  .project-link:hover {
    background: #d32f2f;
    transform: scale(1.05) rotate(-2deg);
  }

  .page-number {
    position: absolute;
    bottom: 25px;
    right: 30px;
    color: #888;
    font-weight: bold;
    font-family: var(--font-main);
  }

  /* Botones */

  .book-btn {
    pointer-events: auto;
    background: #d32f2f;
    color: white;
    border: none;
    padding: 15px 20px;
    border-radius: 50% 20% / 10% 40%;
    cursor: pointer;
    font-family: var(--font-main);
    font-size: 1.3rem;
    font-weight: bold;
    transition: 0.3s;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.2);
  }

  .book-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
    transform: none;
  }

  .book-btn:not(:disabled):hover {
    filter: brightness(1.1);
    transform: scale(1.05) rotate(5deg);
  }

  .book-controls {
    position: absolute;
    top: 50%;
    width: calc(100% + 160px);
    left: -80px;
    display: flex;
    justify-content: space-between;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 10;
  }

 

  @media (max-width: 768px) {
    .book-scene {
        perspective: none;
    }

    .book {
        flex-direction: column;
        height: 80vh;
        overflow-y: auto;
        background: transparent;
        box-shadow: none;
    }
    .book::after { display: none;}
    .page {
        position: relative;
        width: 100%;
        height: auto;
        margin-bottom: 20px;
        border-radius: 8px !important;
    }

    .page-right {
        left: 0;
        transform-origin: center;
        transition: none;
    }
    .book-controls, .page-back {
        display: none !important;
    }

    .page-face {
        position: relative;
        border-radius: 8px;
    }
  }
</style>
